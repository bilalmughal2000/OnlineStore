// Prisma schema — Online Clothing Store
// Covers the core Section 7 data model + fields needed for Phases 1-5.

generator client {
  provider = "prisma-client-js"
  // "native" for local/dev; the rhel-* engines let the client run on
  // CloudLinux/cPanel hosts (pick matches OpenSSL 3.x or 1.1.x automatically).
  binaryTargets = ["native", "rhel-openssl-3.0.x", "rhel-openssl-1.1.x"]
}

datasource db {
  provider = "mysql"
  // Runtime queries go through `url` — point at a pooler in production if the
  // host provides one. Migrations & introspection use `directUrl` (a direct,
  // non-pooled connection). For local MySQL both are the same server.
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_DATABASE_URL")
}

// ─────────────────────────────── Enums ───────────────────────────────

enum Role {
  CUSTOMER
  STAFF
  ADMIN
}

enum ProductStatus {
  DRAFT
  PUBLISHED
  ARCHIVED
}

enum OrderStatus {
  PLACED
  CONFIRMED
  PACKED
  SHIPPED
  OUT_FOR_DELIVERY
  DELIVERED
  CANCELLED
  RETURNED
}

enum PaymentMethod {
  COD
  STRIPE
  JAZZCASH
  EASYPAISA
}

enum PaymentStatus {
  PENDING
  PAID
  FAILED
  REFUNDED
}

enum CouponType {
  PERCENTAGE
  FIXED
}

// ── Meta / Google product-feed attributes ───────────────────────────
// Values mirror the exact vocabularies the Meta catalogue accepts for
// `gender` and `age_group`. Apparel items missing them are commonly
// rejected or under-delivered, so they're modelled as enums rather than
// free text to stop invalid values reaching the feed.
enum ProductGender {
  MALE
  FEMALE
  UNISEX
}

enum ProductAgeGroup {
  NEWBORN
  INFANT
  TODDLER
  KIDS
  ADULT
}

enum SectionType {
  PRODUCT_GRID
  BANNER
  CAROUSEL
  CATEGORY_TILES
}

// ─────────────────────────────── Users ───────────────────────────────

model User {
  id           String    @id @default(cuid())
  name         String
  email        String    @unique
  phone        String?
  passwordHash String
  role         Role      @default(CUSTOMER)
  isBlocked    Boolean   @default(false)
  storeCredit  Decimal   @default(0) @db.Decimal(12, 2)
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  addresses     Address[]
  orders        Order[]
  reviews       Review[]
  wishlist      WishlistItem[]
  cart          Cart?
  refreshTokens RefreshToken[]
  activityLogs  AdminActivityLog[]

  @@index([role])
}

model RefreshToken {
  id        String   @id @default(cuid())
  userId    String
  tokenHash String   @unique
  expiresAt DateTime
  revokedAt DateTime?
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model Address {
  id          String  @id @default(cuid())
  // Null for guest checkout: the address belongs to the order, not to an
  // account. Guests place orders without signing up (see Order.guestEmail).
  userId      String?
  label       String  @default("Home")
  fullName    String
  phone       String
  addressLine String
  city        String
  province    String
  postalCode  String?
  isDefault   Boolean @default(false)

  user   User?   @relation(fields: [userId], references: [id], onDelete: Cascade)
  orders Order[]

  @@index([userId])
}

// ───────────────────────────── Catalog ──────────────────────────────

model Category {
  id          String  @id @default(cuid())
  name        String
  slug        String  @unique
  description String?
  image       String?
  parentId    String?
  isActive    Boolean @default(true)
  sortOrder   Int     @default(0)

  parent   Category?  @relation("CategoryTree", fields: [parentId], references: [id])
  children Category[] @relation("CategoryTree")
  products Product[]

  @@index([parentId])
  @@index([slug])
}

model Product {
  id             String        @id @default(cuid())
  title          String
  slug           String        @unique
  description    String        @db.Text
  basePrice      Decimal       @db.Decimal(12, 2)
  salePrice      Decimal?      @db.Decimal(12, 2)
  costPrice      Decimal?      @db.Decimal(12, 2)
  sku            String?       @unique
  status         ProductStatus @default(DRAFT)
  isFeatured     Boolean       @default(false)
  brand          String?
  fabric         String?
  taxClass       String?
  seoTitle       String?
  seoDescription String?
  fabricCare     String?       @db.Text // rich-text (HTML) for the "Fabric & Care" tab
  shippingReturns String?      @db.Text // rich-text (HTML) for the "Shipping & Returns" tab
  sizeChartImage String?       // optional uploaded size-chart image URL
  sizeChartTable Json?         // optional structured table: { headers: string[], rows: string[][] }
  ratingAvg      Float         @default(0)
  ratingCount    Int           @default(0)
  // Product-feed attributes (Meta catalogue / Google Shopping). Optional so
  // existing products keep working; items missing them still appear in the
  // feed, just with weaker targeting.
  gender               ProductGender?
  ageGroup             ProductAgeGroup?
  // Google product taxonomy id or full path, e.g. "1604" or
  // "Apparel & Accessories > Clothing > Dresses". Meta uses the same taxonomy.
  googleProductCategory String?
  categoryId     String?
  createdAt      DateTime      @default(now())
  updatedAt      DateTime      @updatedAt

  category   Category?         @relation(fields: [categoryId], references: [id])
  variants   ProductVariant[]
  images     ProductImage[]
  reviews    Review[]
  wishlisted WishlistItem[]
  attributes ProductAttribute[]

  @@index([categoryId])
  @@index([status])
  @@index([slug])
}

model ProductVariant {
  id            String  @id @default(cuid())
  productId     String
  size          String?
  color         String?
  colorHex      String?
  sku           String? @unique
  priceOverride Decimal? @db.Decimal(12, 2)
  stock         Int     @default(0)
  images        Json?    // array of image URLs (Json for MySQL compatibility)

  product    Product     @relation(fields: [productId], references: [id], onDelete: Cascade)
  cartItems  CartItem[]
  orderItems OrderItem[]

  @@unique([productId, size, color])
  @@index([productId])
}

model ProductImage {
  id        String  @id @default(cuid())
  productId String
  url       String
  alt       String?
  sortOrder Int     @default(0)
  isPrimary Boolean @default(false)

  product Product @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@index([productId])
}

model Attribute {
  id     String           @id @default(cuid())
  name   String           @unique // e.g. Fabric, Sleeve Type, Occasion
  values AttributeValue[]
}

model AttributeValue {
  id          String @id @default(cuid())
  attributeId String
  value       String

  attribute Attribute          @relation(fields: [attributeId], references: [id], onDelete: Cascade)
  products  ProductAttribute[]

  @@unique([attributeId, value])
}

model ProductAttribute {
  productId        String
  attributeValueId String

  product        Product        @relation(fields: [productId], references: [id], onDelete: Cascade)
  attributeValue AttributeValue @relation(fields: [attributeValueId], references: [id], onDelete: Cascade)

  @@id([productId, attributeValueId])
}

// ─────────────────────────────── Cart ───────────────────────────────

model Cart {
  id             String     @id @default(cuid())
  userId         String?    @unique
  guestSessionId String?    @unique
  couponCode     String?    // applied coupon, persisted so cart & checkout stay in sync
  createdAt      DateTime   @default(now())
  updatedAt      DateTime   @updatedAt

  user  User?      @relation(fields: [userId], references: [id], onDelete: Cascade)
  items CartItem[]
}

model CartItem {
  id        String @id @default(cuid())
  cartId    String
  variantId String
  quantity  Int    @default(1)

  cart    Cart           @relation(fields: [cartId], references: [id], onDelete: Cascade)
  variant ProductVariant @relation(fields: [variantId], references: [id], onDelete: Cascade)

  @@unique([cartId, variantId])
  @@index([cartId])
}

// ─────────────────────────────── Orders ─────────────────────────────

model Order {
  id            String        @id @default(cuid())
  orderNumber   String        @unique
  // Null for guest orders — checkout does not require an account. Contact
  // details then live in guestEmail + the order's Address (fullName / phone).
  userId        String?
  // Required for guest orders; the only way to reach the buyer afterwards.
  guestEmail    String?
  // Unguessable key that lets a guest open their own order (confirmation page,
  // link in the confirmation email) without logging in. Order ids appear in
  // URLs and logs, so they are not treated as secrets.
  guestToken    String?       @unique
  status        OrderStatus   @default(PLACED)
  paymentMethod PaymentMethod
  paymentStatus PaymentStatus @default(PENDING)
  subtotal      Decimal       @db.Decimal(12, 2)
  discount      Decimal       @default(0) @db.Decimal(12, 2)
  shipping      Decimal       @default(0) @db.Decimal(12, 2)
  tax           Decimal       @default(0) @db.Decimal(12, 2)
  total         Decimal       @db.Decimal(12, 2)
  couponCode    String?
  addressId     String?
  notes         String?
  codVerified   Boolean       @default(false)
  cancelReason  String?
  createdAt     DateTime      @default(now())
  updatedAt     DateTime      @updatedAt

  user       User?            @relation(fields: [userId], references: [id])
  address    Address?         @relation(fields: [addressId], references: [id])
  items      OrderItem[]
  payments   Payment[]
  statusLogs OrderStatusLog[]

  @@index([userId])
  @@index([status])
  @@index([createdAt])
  // Guest order lookup + per-email coupon limits.
  @@index([guestEmail])
}

model OrderItem {
  id           String  @id @default(cuid())
  orderId      String
  variantId    String
  productTitle String
  variantLabel String?
  price        Decimal @db.Decimal(12, 2)
  quantity     Int

  order   Order          @relation(fields: [orderId], references: [id], onDelete: Cascade)
  variant ProductVariant @relation(fields: [variantId], references: [id])

  @@index([orderId])
}

model OrderStatusLog {
  id        String      @id @default(cuid())
  orderId   String
  status    OrderStatus
  note      String?
  createdAt DateTime    @default(now())

  order Order @relation(fields: [orderId], references: [id], onDelete: Cascade)

  @@index([orderId])
}

model Payment {
  id            String        @id @default(cuid())
  orderId       String
  gateway       PaymentMethod
  transactionId String?
  status        PaymentStatus @default(PENDING)
  amount        Decimal       @db.Decimal(12, 2)
  rawResponse   Json?
  createdAt     DateTime      @default(now())

  order Order @relation(fields: [orderId], references: [id], onDelete: Cascade)

  @@index([orderId])
}

// ────────────────────────── Marketing ──────────────────────────────

model Coupon {
  id           String     @id @default(cuid())
  code         String     @unique
  type         CouponType
  value        Decimal    @db.Decimal(12, 2)
  minOrderValue Decimal   @default(0) @db.Decimal(12, 2)
  usageLimit   Int?
  perUserLimit Int?
  usedCount    Int        @default(0)
  isActive     Boolean    @default(true)
  startsAt     DateTime?
  expiresAt    DateTime?
  createdAt    DateTime   @default(now())
}

// ────────────────────────── Reviews / Wishlist ─────────────────────

model Review {
  id         String   @id @default(cuid())
  productId  String
  // Null when the reviewer wasn't signed in. Anyone may review — see
  // guestName for who to display.
  userId     String?
  // Display name for a review left without an account.
  guestName  String?
  rating     Int
  comment    String?
  images     Json?    // array of image URLs (Json for MySQL compatibility)
  isApproved Boolean  @default(false)
  reply      String?
  createdAt  DateTime @default(now())

  product Product @relation(fields: [productId], references: [id], onDelete: Cascade)
  user    User?   @relation(fields: [userId], references: [id], onDelete: Cascade)

  // Still one review per account per product (editable). MySQL permits repeated
  // NULLs in a unique index, so anonymous reviews are not limited by this.
  @@unique([productId, userId])
  @@index([productId])
}

model WishlistItem {
  id        String   @id @default(cuid())
  userId    String
  productId String
  createdAt DateTime @default(now())

  user    User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  product Product @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@unique([userId, productId])
}

// ───────────────────── Homepage / CMS / Settings ───────────────────

model HomepageSection {
  id        String      @id @default(cuid())
  title     String
  type      SectionType
  config    Json
  sortOrder Int         @default(0)
  isActive  Boolean     @default(true)
  startDate DateTime?
  endDate   DateTime?
  createdAt DateTime    @default(now())
}

model Banner {
  id        String   @id @default(cuid())
  title     String?  // hero heading
  subtitle  String?  // hero subheading
  ctaLabel  String?  // call-to-action button text
  imageUrl  String
  mobileImageUrl String?
  link      String?
  position  String   @default("hero") // hero | strip | sidebar
  isActive  Boolean  @default(true)
  sortOrder Int      @default(0)
  startDate DateTime?
  endDate   DateTime?
}

model MenuItem {
  id        String  @id @default(cuid())
  label     String
  url       String
  location  String  @default("header") // header | footer
  parentId  String?
  sortOrder Int     @default(0)
  isActive  Boolean @default(true)

  parent   MenuItem?  @relation("MenuTree", fields: [parentId], references: [id])
  children MenuItem[] @relation("MenuTree")
}

model StaticPage {
  id             String   @id @default(cuid())
  slug           String   @unique
  title          String
  content        String   @db.Text
  seoTitle       String?
  seoDescription String?
  isPublished    Boolean  @default(true)
  updatedAt      DateTime @updatedAt
}

model Setting {
  key   String @id
  value Json
}

// Admin-editable copy for a transactional email. One row per email the store
// sends, keyed by EmailTemplateKey (ORDER_PLACED, PASSWORD_RESET, …).
//
// A missing row — or isEnabled = false — means the built-in default is used, so
// a bad edit can always be undone by disabling it. Only the body is stored; the
// branded shell, colours and footer are applied at send time.
model EmailTemplate {
  key       String   @id
  subject   String   @db.Text
  html      String   @db.Text
  isEnabled Boolean  @default(true)
  updatedAt DateTime @updatedAt
}

/// Immutable record of every write made through the admin panel.
///
/// The actor's name and email are copied onto the row rather than only being
/// joined from User. An audit trail has to outlive the account it describes —
/// when a staff member leaves and their account is removed, the history of what
/// they did must stay readable, so `adminId` goes null while the record remains.
model AdminActivityLog {
  id         String   @id @default(cuid())
  adminId    String?
  adminName  String
  adminEmail String
  action     String
  entity     String
  entityId   String?
  meta       Json?
  createdAt  DateTime @default(now())

  admin User? @relation(fields: [adminId], references: [id], onDelete: SetNull)

  @@index([adminId])
  @@index([createdAt])
}
