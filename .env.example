# ─── Database (MySQL) ───────────────────────────────────────
# DATABASE_URL is used for runtime queries. connection_limit caps how many
# connections THIS process opens; pool_timeout is how long (s) a query waits
# for a free connection before erroring. Keep:
#   connection_limit × (PM2 instances) ≤ MySQL max_connections − headroom
DATABASE_URL="mysql://root:root@localhost:3307/clothing_store?connection_limit=10&pool_timeout=20"

# DIRECT_DATABASE_URL is a direct (non-pooled) connection used ONLY for
# migrations/introspection. Locally it's the same server. Prisma `migrate dev`
# needs privileges to create a temporary shadow database — hence root locally.
DIRECT_DATABASE_URL="mysql://root:root@localhost:3307/clothing_store"

# ── Production (cPanel / managed MySQL) ─────────────────────
# Use your host's DB user + credentials. In production use `migrate deploy`
# (no shadow DB needed), so a limited DB user is fine:
#   DATABASE_URL="mysql://dbuser:pass@host:3306/dbname?connection_limit=10&pool_timeout=20"
#   DIRECT_DATABASE_URL="mysql://dbuser:pass@host:3306/dbname"

# ─── Redis ──────────────────────────────────────────────────
REDIS_URL="redis://localhost:6380"

# ─── API ────────────────────────────────────────────────────
API_PORT=4000
NODE_ENV=development
CORS_ORIGINS="http://localhost:3000,http://localhost:5173"

# ─── Auth (JWT) ─────────────────────────────────────────────
JWT_ACCESS_SECRET="change-me-access-secret"
JWT_REFRESH_SECRET="change-me-refresh-secret"
JWT_ACCESS_TTL="15m"
JWT_REFRESH_TTL="30d"

# ─── Seed admin ─────────────────────────────────────────────
SEED_ADMIN_EMAIL="admin@store.pk"
SEED_ADMIN_PASSWORD="admin12345"

# ─── Storefront (Next.js) ───────────────────────────────────
NEXT_PUBLIC_API_URL="http://localhost:4000/api"
# On-demand cache revalidation: the API pings the storefront so admin changes
# (theme, menu, pages, catalog) reflect instantly. Both must share the secret.
STOREFRONT_URL="http://localhost:3000"
REVALIDATE_SECRET="dev-revalidate-secret"

# ─── SEO ────────────────────────────────────────────────────
# Public origin of the storefront. Drives canonical URLs, Open Graph URLs and
# sitemap.xml entries. MUST be the real https:// domain in production, or Google
# will index localhost URLs. robots.txt also blocks all crawling unless this is
# set to a non-localhost value — that's the staging safety net.
NEXT_PUBLIC_SITE_URL="http://localhost:3000"

# ─── Analytics (client-side) ────────────────────────────────
# Both optional: leave blank and no tags load at all (no console noise in dev).
# GA4 "Measurement ID" from Admin → Data Streams (looks like G-XXXXXXXXXX).
NEXT_PUBLIC_GA_MEASUREMENT_ID=""
# Meta Pixel ID from Events Manager → Data Sources (numeric).
NEXT_PUBLIC_META_PIXEL_ID=""

# ─── Meta Conversions API (server-side) ─────────────────────
# Sends Purchase events from the API so sales aren't lost to ad-blockers and
# iOS tracking prevention. META_PIXEL_ID must be the SAME pixel as
# NEXT_PUBLIC_META_PIXEL_ID above, or events won't deduplicate and every online
# sale is counted twice.
# Token: Events Manager → your pixel → Settings → "Generate access token".
META_PIXEL_ID=""
META_CAPI_ACCESS_TOKEN=""
# Set temporarily to a code from Events Manager → Test Events to verify the
# integration, then clear it (test events don't count as real conversions).
META_CAPI_TEST_EVENT_CODE=""

# ─── Meta domain verification ───────────────────────────────
# Business Settings → Brand Safety → Domains → add your domain → copy the
# meta-tag value here (just the content string, not the whole tag). Required
# before you can prioritise Purchase in Aggregated Event Measurement, which is
# what keeps iOS conversion reporting working. A DNS TXT record is the
# alternative and needs no code.
NEXT_PUBLIC_META_DOMAIN_VERIFICATION=""

# ─── Product catalogue feed ─────────────────────────────────
# No config needed — served at ${STOREFRONT_URL}/api/feed/products.xml (via the
# Nginx /api proxy). Point Commerce Manager → Catalogue → Data Sources →
# Scheduled Feed at that URL and set it to refresh hourly.
#
# IMPORTANT: the feed's g:id is the PRODUCT id, matching the content_ids the
# Pixel sends. Do not switch the feed to variant-level ids without also changing
# the Pixel — mismatched ids make retargeting silently attribute nothing.

# ─── Admin (Vite) ───────────────────────────────────────────
VITE_API_URL="http://localhost:4000/api"

# ─── Payments (Phase 4 — placeholders) ──────────────────────
STRIPE_SECRET_KEY=""
STRIPE_WEBHOOK_SECRET=""
JAZZCASH_MERCHANT_ID=""
JAZZCASH_PASSWORD=""
JAZZCASH_INTEGRITY_SALT=""
EASYPAISA_STORE_ID=""
EASYPAISA_HASH_KEY=""

# ─── Image uploads (Cloudinary) ─────────────────────────────
# If set, admin image uploads go to Cloudinary (CDN). If blank, dev falls back
# to storing uploads on local disk at apps/api/uploads (not for production).
CLOUDINARY_CLOUD_NAME=""
CLOUDINARY_API_KEY=""
CLOUDINARY_API_SECRET=""

# ─── Email — HTTP API (use on Railway/Vercel/Render) ────────
# Most hosting platforms BLOCK outbound SMTP ports as an anti-spam measure, so
# SMTP simply times out there (ETIMEDOUT). HTTPS is never blocked, so use the
# provider's HTTP API instead. When this token is set it takes priority over
# the SMTP settings below.
#   Mailtrap -> Settings -> API Tokens
MAILTRAP_API_TOKEN=""
# Sandbox inbox id (Email Testing -> your inbox -> the number in its URL).
# SET   = testing; nothing is delivered, everything lands in the web inbox.
# UNSET = Mailtrap delivers for real (requires a verified sending domain).
MAILTRAP_INBOX_ID=""

# ─── Email (SMTP — e.g. your hosting provider's mailbox) ────
# Leave SMTP_HOST blank in dev to log emails to the console instead of sending.
SMTP_HOST=""
SMTP_PORT="587"
SMTP_SECURE="false"        # true for port 465, false for 587 (STARTTLS)
SMTP_USER=""
SMTP_PASS=""
EMAIL_FROM="Aabroo <orders@store.pk>"

# ─── WhatsApp Cloud API (official; optional) ────────────────
# When these are set, order notifications are also sent via WhatsApp using an
# approved template. Leave blank to disable (emails still send).
WHATSAPP_PHONE_NUMBER_ID=""
WHATSAPP_ACCESS_TOKEN=""
WHATSAPP_TEMPLATE_ORDER="order_update"   # name of your approved template
WHATSAPP_LANG="en"

# ─── Courier: PostEx ────────────────────────────────────────
# Merchant API token from the PostEx portal (Settings → API). Leave blank and the
# courier panel stays visible but says "no token" — nothing can be booked.
# The rest of the setup (pickup address code, order type, auto-booking, the
# customer tracking link) lives in admin → Settings → Courier, not here.
POSTEX_API_TOKEN=""
# Override only for testing against a mock/sandbox; defaults to the live API.
# POSTEX_BASE_URL="https://api.postex.pk/services/integration/api/order"
