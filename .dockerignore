# Keep the build context small and force a clean install/build inside the image.
node_modules
**/node_modules

# Build outputs — regenerated by `npm run build:api`
dist
**/dist
.next
**/.next
*.tsbuildinfo

# Never ship secrets or local state
.env
.env.*
!.env.example
.devlogs
*.log

.git
.github
.claude

# Not needed to build or run the API
docs
deploy
apps/api/uploads
